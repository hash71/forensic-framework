**/vendor/
**/node_modules/
**/.phpunit.cache/
**/.phpunit.result.cache
forensic-laravel/bootstrap/cache/*.php
forensic-laravel/database/*.sqlite*
forensic-laravel/public/build/
forensic-laravel/public/hot
forensic-laravel/public/storage
forensic-laravel/storage/*.key
forensic-laravel/storage/pail/

